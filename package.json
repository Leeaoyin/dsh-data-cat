{
  "name": "@local/dshcat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DshDataCat: a Navicat-style database manager for MySQL, PostgreSQL, Redis, and Elasticsearch, with SQL playground and AI copilot.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "database-manager",
    "mysql",
    "postgresql",
    "redis",
    "elasticsearch",
    "sql-editor",
    "ai",
    "navicat"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "img/*",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "xlsx": "0.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
